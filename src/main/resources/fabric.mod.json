  "entrypoints": {
    "client": ["dev.cerba.healthindicator.HealthIndicator"]
  },
  "mixins": ["healthindicator.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
